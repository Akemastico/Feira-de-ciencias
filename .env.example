OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=256
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_CONNECT=5
OLLAMA_TIMEOUT_READ=120

WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

KOKORO_VOICE=pf_dora
KOKORO_LANG=p
KOKORO_SPEED=1.0

EMOTIONS=neutro,feliz,triste,surpreso,curioso,bravo

LOG_LEVEL=INFO
LOG_TO_FILE=1
LOG_FILE=logs/bmo.log

# 1 = carrega Whisper/Kokoro em segundo plano ao subir o servidor
# 0 = carrega na primeira pergunta (máquina fraca)
BMO_PRELOAD=1
