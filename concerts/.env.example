OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=256
OLLAMA_TEMPERATURE=0.85
# 24h = mantém o modelo carregado na RAM/VRAM por 24h (evita descarregar entre usos)
OLLAMA_KEEP_ALIVE=24h
OLLAMA_TIMEOUT_CONNECT=5
OLLAMA_TIMEOUT_READ=120

WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

KOKORO_VOICE=pf_dora
KOKORO_LANG=p
KOKORO_SPEED=1.0

EMOTIONS=neutro,feliz,triste,surpreso,curioso,bravo

LOG_LEVEL=INFO
LOG_TO_FILE=1
LOG_FILE=logs/bmo.log

# 1 = carrega Whisper/Kokoro em segundo plano ao subir o servidor
BMO_PRELOAD=1

# 0 = modo normal; 1 = respostas roteirizadas (testes E2E)
BMO_E2E=0

# 0 = ações desligadas; 1 = ações do modelo (expressao, animacao, texto, led, som)
BMO_ACOES=0
